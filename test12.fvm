func get_rdtsc
    PUSH int:0
    DUP
    LOCAL_SET 0
    GLOBAL_SET result
    INLINE_ASM "rdtsc                    \n                shlq $$32, %rdx          \n                orq %rdx, %rax" "\"=a\"(result)::\"rdx\"" 0 0
    LOCAL_GET 0
    RET
endfunc

